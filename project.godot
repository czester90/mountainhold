config_version=5

[application]

config/name="Mountain Fortress Environment"
config/description="Grounded, low-poly mountain fortress environment. Environment build-out only (staged). No gameplay systems."
run/main_scene="res://scenes/test/project_startup_test.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

