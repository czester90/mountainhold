; Engine configuration file.
; Mountain Fortress Environment Project
;
; This file is auto-generated and edited by Godot; hand edits here are
; intentional and kept minimal. See docs/project_overview.md.

config_version=5

[application]

config/name="Mountainhold"
config/description="First-person archery castle-siege: defend a Helm's-Deep-style mountain fortress from the walls."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameSettings="*res://scripts/game_settings.gd"
Audio="*res://scripts/core/audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg", "res://addons/gdUnit4/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.12, 0.12, 0.13, 1)
anti_aliasing/quality/msaa_3d=2
